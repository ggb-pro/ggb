# .env.example — 复制为 .env 后填写实际值

# App
APP_NAME=knSpace
DEBUG=true
SECRET_KEY=change-me-to-random-string

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://knspace:knspace_dev@localhost/knspace

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector store (Milvus Lite)
VECTOR_STORE_URI=./milvus_data.db

# Embedding (API-first with local fallback)
EMBEDDING_BACKEND=api
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-api-key
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker (API-first with local fallback)
RERANK_BACKEND=api
RERANK_API_URL=https://api.jina.ai/v1/rerank
RERANK_API_KEY=your-api-key
RERANK_MODEL=jina-reranker-v2-base-multilingual

# OCR (API-first with local fallback)
OCR_BACKEND=local
OCR_API_URL=
OCR_API_KEY=

# LLM
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-chat

# File storage
FILE_STORAGE_PATH=/data/files
